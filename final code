DEFAULT_DATA=[42,17,8,93,26,55,11,68,34,5,79,21]
SAFE_SELECTION_LIMIT=5000
HYBRID_THRESHOLD=32

def selection_sort(data):
    a=list(data); comparisons=swaps=0
    for i in range(len(a)-1):
        m=i
        for j in range(i+1,len(a)):
            comparisons+=1
            if a[j]<a[m]: m=j
        if m!=i: a[i],a[m]=a[m],a[i]; swaps+=1
    return a,comparisons,swaps

def selection_steps(data):
    a=list(data);rows=[];comparisons=swaps=0
    for i in range(len(a)-1):
        m=i
        for j in range(i+1,len(a)):
            comparisons+=1
            if a[j]<a[m]:m=j
        minimum=a[m];did_swap=m!=i
        if did_swap:a[i],a[m]=a[m],a[i];swaps+=1
        rows.append((i+1,minimum,m+1,"Yes" if did_swap else "No",list(a)))
    return a,comparisons,swaps,rows

def sequential_search(data,key):
    for i,x in enumerate(data):
        if x==key:return i, i+1
    return -1,len(data)

def merge_sort(data):
    comparisons=0
    def sort(a):
        nonlocal comparisons
        if len(a)<=1:return a
        mid=len(a)//2;left=sort(a[:mid]);right=sort(a[mid:])
        out=[];i=j=0
        while i<len(left) and j<len(right):
            comparisons+=1
            if left[i]<=right[j]:out.append(left[i]);i+=1
            else:out.append(right[j]);j+=1
        out.extend(left[i:]);out.extend(right[j:]);return out
    t=time.perf_counter();result=sort(list(data))
    return result,comparisons,time.perf_counter()-t

def hybrid_merge_insertion_sort(data,threshold=HYBRID_THRESHOLD):
    comparisons=0
    def insertion(a):
        nonlocal comparisons
        for i in range(1,len(a)):
            key=a[i];j=i-1
            while j>=0:
                comparisons+=1
                if a[j]>key:a[j+1]=a[j];j-=1
                else:break
            a[j+1]=key
        return a
    def sort(a):
        nonlocal comparisons
        if len(a)<=threshold:return insertion(a)
        mid=len(a)//2;left=sort(a[:mid]);right=sort(a[mid:])
        out=[];i=j=0
        while i<len(left) and j<len(right):
            comparisons+=1
            if left[i]<=right[j]:out.append(left[i]);i+=1
            else:out.append(right[j]);j+=1
        out.extend(left[i:]);out.extend(right[j:]);return out
    t=time.perf_counter();result=sort(list(data))
    return result,comparisons,time.perf_counter()-t

def binary_search(sorted_data,key):
    lo,hi=0,len(sorted_data)-1;comparisons=0
    while lo<=hi:
        mid=(lo+hi)//2;comparisons+=1
        if sorted_data[mid]==key:return mid,comparisons
        if sorted_data[mid]<key:lo=mid+1
        else:hi=mid-1
    return -1,comparisons

def selection_comparisons(n):return n*(n-1)//2

def load_csv(path,limit=1000000):
    with open(path,"r",encoding="utf-8-sig",newline="") as f:
        reader=csv.DictReader(f)
        if not reader.fieldnames:raise ValueError("CSV needs a header.")
        cols=reader.fieldnames
        values_by_col={c:[] for c in cols}
        for row in reader:
            for c in cols:
                raw=row.get(c,"")
                if raw in ("",None):continue
                try:
                    values_by_col[c].append(float(raw))
                except ValueError:pass
            if max((len(v) for v in values_by_col.values()),default=0)>=limit:break
        numeric=[(c,v) for c,v in values_by_col.items() if v]
        if not numeric:raise ValueError("No numeric column found.")
        return numeric[0][1],numeric[0][0]

def load_parquet(path,limit=1000000):
    try:
        import pandas as pd
    except ImportError as e:
        raise RuntimeError("Parquet needs pandas + pyarrow. Run: pip install pandas pyarrow") from e
    df=pd.read_parquet(path)
    cols=df.select_dtypes(include="number").columns.tolist()
    if not cols:raise ValueError("No numeric column found.")
    s=df[cols[0]].dropna().iloc[:limit]
    return s.astype(float).tolist(),str(cols[0])

class App(tk.Tk):
    def __init__(self):
